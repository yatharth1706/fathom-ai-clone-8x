# Postgres (Neon)
DATABASE_URL=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=          # e.g. https://pub-xxxx.r2.dev or custom domain

# Providers
ASR_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_WEBHOOK_SECRET=   # random string; checked on webhook requests
LLM_PROVIDER=gemini          # only gemini is implemented; others plug in via src/lib/providers (LlmProvider)
GEMINI_API_KEY=
GEMINI_MODEL=                # default gemini-flash-latest
GEMINI_FALLBACK_MODEL=       # optional; used while the primary model returns 503

# App
PUBLIC_BASE_URL=             # e.g. https://your-app.vercel.app; unset/localhost => ASR polling instead of webhooks
UPLOAD_DAILY_LIMIT=3
ASK_DAILY_LIMIT=30          # "Ask this meeting" questions per IP per day
IP_HASH_SALT=                # random string
